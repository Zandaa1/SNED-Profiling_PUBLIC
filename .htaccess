# ==========================================================
# ValSNED Performance: Caching & Compression
# ==========================================================

# ---------- Compression (gzip/deflate) ----------
<IfModule mod_deflate.c>
    # Compress text-based assets
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    # woff2 is already compressed; skip it
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
    ExpiresActive On

    # Fonts — long cache (1 year), they never change
    ExpiresByType font/woff  "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Images — long cache (6 months)
    ExpiresByType image/png    "access plus 6 months"
    ExpiresByType image/jpeg   "access plus 6 months"
    ExpiresByType image/webp   "access plus 6 months"
    ExpiresByType image/x-icon "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"

    # JavaScript — moderate cache (1 month, versioned via ?v= param)
    ExpiresByType text/javascript        "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # CSS — NO cache (user requested: there might be changes)
    ExpiresByType text/css "access plus 0 seconds"
</IfModule>

# ---------- Cache-Control headers ----------
<IfModule mod_headers.c>
    # Fonts: immutable, 1 year
    <FilesMatch "\.(woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images: 6 months
    <FilesMatch "\.(png|jpg|jpeg|webp|ico|svg)$">
        Header set Cache-Control "public, max-age=15768000"
    </FilesMatch>

    # JS: 1 month (busted by ?v= query string)
    <FilesMatch "\.(js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # CSS: no-cache (always revalidate)
    <FilesMatch "\.(css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # WebP content type
    <FilesMatch "\.webp$">
        Header set Content-Type "image/webp"
    </FilesMatch>
</IfModule>

# ---------- Correct MIME types ----------
<IfModule mod_mime.c>
    AddType font/woff  .woff
    AddType font/woff2 .woff2
    AddType image/webp .webp
</IfModule>
